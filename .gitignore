uzp-artifact/z_polyhedrator/target/
uzp-artifact/spmv-executors/uzp-genex/spf_matvec
uzp-artifact/spmv-executors/uzp-genex/spf_matvec_omp
uzp-artifact/spmv-executors/uzp-genex/spf_aggregator
uzp-artifact/spmv-executors/uzp-genex/spf_aggregator_omp
uzp-artifact/spmv-executors/spmv-mkl/
uzp-artifact/spmv-executors/spmv-csr/
uzp-artifact/spmv-executors/spmv-csr5/
uzp-artifact/uzp-tuners/spf_aggregator
uzp-artifact/uzp-tuners/spf_aggregator_omp
uzp-artifact/uzp-tuners/spf_tiling_tuner
uzp-artifact/**/*.uzp
